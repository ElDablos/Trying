<?xml version="1.0" encoding="utf-8"?>
<!-- Near-black with a faint red glow at the top, like the wallpapers. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><solid android:color="@color/void_black" /></shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.5"
                android:centerY="0"
                android:endColor="#000A0708"
                android:gradientRadius="420dp"
                android:startColor="#552A050B"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
