<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <!-- Left: clock, date, weather, steps -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:orientation="vertical">

        <!-- Clock and alarm: tap for alarms -->
        <LinearLayout
            android:id="@+id/clock_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/bone"
                android:textSize="48sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alarm" />

                <TextView
                    android:id="@+id/alarm_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="07:00"
                    android:textColor="@color/dust"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Date: tap for calendar -->
        <TextClock
            android:id="@+id/date_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/crimson"
            android:textSize="13sp" />

        <!-- Weather: tap to refresh -->
        <LinearLayout
            android:id="@+id/weather_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/weather_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_weather_rain" />

                <TextView
                    android:id="@+id/weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-light"
                    android:text="14°"
                    android:textColor="@color/bone"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/weather_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Rain showers"
                    android:textColor="@color/bone"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/weather_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="↑16° ↓10° · Stratford"
                android:textColor="@color/dust"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Steps: tap for Samsung Health -->
        <LinearLayout
            android:id="@+id/steps_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_steps" />

                <TextView
                    android:id="@+id/steps_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="8,309 steps"
                    android:textColor="@color/bone"
                    android:textSize="14sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/steps_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="83"
                android:progressDrawable="@drawable/steps_bar" />

            <TextView
                android:id="@+id/steps_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="83% of 10,000"
                android:textColor="@color/dust"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

