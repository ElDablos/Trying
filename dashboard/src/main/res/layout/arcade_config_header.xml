<?xml version="1.0" encoding="utf-8"?>
<!-- The top of the Arcade settings: it scrolls with the app list below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:letterSpacing="0.35"
        android:text="ARCADE"
        android:textColor="@color/crimson"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        style="@style/NoteText"
        android:gravity="center"
        android:text="Games are found automatically and listed A–Z. Tap any app below to add it to the Arcade or hide it." />

    <TextView
        android:id="@+id/arcade_problem"
        style="@style/BodyText"
        android:textColor="@color/crimson"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <LinearLayout style="@style/Card">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.18"
            android:text="MOST PLAYED"
            android:textColor="@color/bone"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/arcade_stats_status"
            style="@style/NoteText" />

        <Button
            android:id="@+id/arcade_stats_button"
            style="@style/ButtonOutline"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="Turn on usage access" />
    </LinearLayout>

    <TextView
        android:id="@+id/arcade_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="2dp"
        android:letterSpacing="0.18"
        android:textAllCaps="true"
        android:textColor="@color/dust"
        android:textSize="11sp" />
</LinearLayout>
