<resources>
    <style name="AppTheme" parent="android:Theme.Material">
        <item name="android:colorPrimary">@color/blood</item>
        <item name="android:colorPrimaryDark">@color/void_black</item>
        <item name="android:colorAccent">@color/crimson</item>
        <item name="android:windowBackground">@color/void_black</item>
        <item name="android:statusBarColor">@color/void_black</item>
        <item name="android:navigationBarColor">@color/void_black</item>
    </style>

    <style name="AppTheme.NoTitle">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- The home screen sits over the wallpaper; the launcher draws its own status bar. -->
    <style name="LauncherTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">@color/crimson</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
