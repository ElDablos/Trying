<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when there's no album art: a dark tile with a crimson note. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1214" />
            <stroke android:width="1dp" android:color="@color/widget_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_music_note" android:bottom="12dp" android:left="12dp" android:right="12dp" android:top="12dp" />
</layer-list>
