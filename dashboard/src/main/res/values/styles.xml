<resources>
    <style name="Card">
        <item name="android:tag">hud_card</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/card_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:tag">hud_title</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CardIcon">
        <item name="android:tag">hud_icon</item>
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
    </style>

    <style name="Pill">
        <item name="android:tag">hud_pill</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="BodyText">
        <item name="android:tag">hud_body</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="NoteText">
        <item name="android:tag">hud_note</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/dust</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ButtonBase">
        <item name="android:layout_height">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ButtonPrimary" parent="ButtonBase">
        <item name="android:tag">hud_primary</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/bone</item>
    </style>

    <style name="ButtonOutline" parent="ButtonBase">
        <item name="android:tag">hud_outline</item>
        <item name="android:background">@drawable/button_outline</item>
        <item name="android:textColor">@color/crimson</item>
    </style>

    <style name="Input">
        <item name="android:tag">hud_input</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:textColorHint">@color/dust</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- A floating card over the home screen for the queue. -->
    <style name="QueuePopup" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:colorAccent">@color/crimson</item>
    </style>
</resources>
