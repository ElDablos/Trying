<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/crimsonicons" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.35"
            android:text="CRIMSON"
            android:textColor="@color/crimson"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.6"
            android:text="ICONS"
            android:textColor="@color/dust"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/coverage_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/bone"
                android:textSize="16sp" />

            <Button
                android:id="@+id/open_goodlock_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_primary"
                android:stateListAnimator="@null"
                android:text="Open Good Lock to apply"
                android:textAllCaps="false"
                android:textColor="@color/bone"
                android:textSize="15sp" />

            <Button
                android:id="@+id/copy_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_outline"
                android:stateListAnimator="@null"
                android:text="Copy list of apps without an icon"
                android:textAllCaps="false"
                android:textColor="@color/crimson"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="Paste that list to Claude to get matching icons for those apps in the next version."
                android:textColor="@color/dust"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.15"
            android:text="APPS WITHOUT A CRIMSON ICON YET"
            android:textColor="@color/crimson"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/missing_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/dust"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
