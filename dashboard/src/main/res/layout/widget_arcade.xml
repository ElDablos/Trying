                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="M"
                        android:textColor="#4D9A8A8C"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/arcade_rail_14"
                        android:layout_width="match_parent"
