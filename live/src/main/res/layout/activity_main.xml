<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:letterSpacing="0.35"
        android:text="CRIMSON"
        android:textColor="@color/crimson"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.6"
        android:text="LIVE"
        android:textColor="@color/dust"
        android:textSize="12sp" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/wallpaper_description"
        android:scaleType="fitCenter"
        android:src="@drawable/preview" />

    <TextView
        android:id="@+id/tilt_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tilt effect: 60%"
        android:textColor="@color/bone"
        android:textSize="15sp" />

    <SeekBar
        android:id="@+id/tilt_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:max="100"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:progressBackgroundTint="@color/dust"
        android:progressTint="@color/crimson"
        android:thumbTint="@color/crimson" />

    <Button
        android:id="@+id/set_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/button_primary"
        android:letterSpacing="0.12"
        android:stateListAnimator="@null"
        android:text="SET ROSE WINDOW"
        android:textColor="@color/bone"
        android:textSize="15sp" />

    <Button
        android:id="@+id/reactor_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_primary"
        android:letterSpacing="0.12"
        android:stateListAnimator="@null"
        android:text="SET CRIMSON REACTOR (3D)"
        android:textColor="@color/bone"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Tilt your phone to see the layers move. Everything pauses whenever the wallpaper is hidden, so it only uses power while you can see it."
        android:textColor="@color/dust"
        android:textSize="12sp" />
</LinearLayout>
