<?xml version="1.0" encoding="utf-8"?>
<!-- Crimson Glance: one slim row of weather, steps, Buds and next alarm, for the lock or home screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/glance_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/glance_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/glance_weather"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/glance_weather_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_sun" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/glance_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="13°"
                    android:textColor="@color/bone"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/glance_weather_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="80dp"
                    android:text="London"
                    android:textColor="@color/dust"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
        android:id="@+id/theme_glance_divider_1"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_divider_vertical" />
        <LinearLayout
            android:id="@+id/glance_steps_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
        android:id="@+id/theme_glance_steps_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_steps" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/glance_steps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="2,957"
                    android:textColor="@color/bone"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/glance_steps_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="56dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="30"
                    android:progressDrawable="@drawable/steps_bar" />
                <TextView
                    android:id="@+id/glance_steps_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="80dp"
                    android:text="steps"
                    android:textColor="@color/dust"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/glance_buds_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_divider_vertical" />
        <LinearLayout
            android:id="@+id/glance_buds"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
        android:id="@+id/theme_glance_buds_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_buds" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/glance_buds_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="92 · 94%"
                    android:textColor="@color/bone"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/glance_buds_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="80dp"
                    android:text="ANC"
                    android:textColor="@color/dust"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
        android:id="@+id/theme_glance_divider_3"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_divider_vertical" />
        <LinearLayout
            android:id="@+id/glance_alarm_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
        android:id="@+id/theme_glance_alarm_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_alarm" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/glance_alarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="19:00"
                    android:textColor="@color/bone"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/glance_alarm_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="80dp"
                    android:text="alarm"
                    android:textColor="@color/dust"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
