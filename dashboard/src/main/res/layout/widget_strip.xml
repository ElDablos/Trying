<?xml version="1.0" encoding="utf-8"?>
<!-- Crimson App Strip: a stack of cards, six apps each. Swipe up or down to flip between them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <StackView
        android:id="@+id/strip_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true" />

    <!-- Shown until apps are picked. -->
    <FrameLayout
        android:id="@+id/strip_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/strip_empty_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:text="TAP TO CHOOSE APPS"
            android:textColor="@color/crimson"
            android:textSize="13sp" />
    </FrameLayout>
</FrameLayout>
