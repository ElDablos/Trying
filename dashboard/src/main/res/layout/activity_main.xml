<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.35"
            android:text="CRIMSON"
            android:textColor="@color/crimson"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.6"
            android:text="WIDGET"
            android:textColor="@color/dust"
            android:textSize="12sp" />

        <!-- Live clock, like the widget -->
        <TextClock
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/bone"
            android:textSize="84sp" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:textAllCaps="true"
            android:textColor="@color/crimson"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:scaleType="fitXY"
            android:src="@drawable/divider_horizontal" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/CardIcon"
                    android:src="@drawable/ic_weather_cloud" />

                <TextView
                    style="@style/CardTitle"
                    android:text="Weather" />

                <TextView
                    android:id="@+id/weather_pill"
                    style="@style/Pill"
                    android:background="@drawable/pill_off"
                    android:text="Off"
                    android:textColor="@color/dust" />
            </LinearLayout>

            <TextView
                android:id="@+id/place_text"
                style="@style/BodyText" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/city_input"
                    style="@style/Input"
                    android:hint="Town or city"
                    android:imeOptions="actionDone"
                    android:inputType="textCapWords" />

                <Button
                    android:id="@+id/search_button"
                    style="@style/ButtonPrimary"
                    android:layout_width="wrap_content"
                    android:text="Search" />
            </LinearLayout>
            <Button
                android:id="@+id/my_location_button"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="Use my location" />

            <Button
                android:id="@+id/weather_app_button"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Weather tap opens: choose an app" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/CardIcon"
                    android:src="@drawable/ic_steps" />

                <TextView
                    style="@style/CardTitle"
                    android:text="Steps" />

                <TextView
                    android:id="@+id/steps_pill"
                    style="@style/Pill"
                    android:background="@drawable/pill_off"
                    android:text="Off"
                    android:textColor="@color/dust" />
            </LinearLayout>

            <TextView
                android:id="@+id/steps_status"
                style="@style/BodyText" />
            <Button
                android:id="@+id/steps_button"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Connect steps" />
            <TextView
                style="@style/NoteText"
                android:text="Steps come from Health Connect. In Samsung Health, open the menu → Settings → Health Connect, and let it share steps." />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/goal_input"
                    style="@style/Input"
                    android:hint="Daily goal"
                    android:imeOptions="actionDone"
                    android:inputType="number" />

                <Button
                    android:id="@+id/goal_button"
                    style="@style/ButtonPrimary"
                    android:layout_width="wrap_content"
                    android:text="Save" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/CardIcon"
                    android:src="@drawable/ic_event" />

                <TextView
                    style="@style/CardTitle"
                    android:text="Calendar" />

                <TextView
                    android:id="@+id/calendar_pill"
                    style="@style/Pill"
                    android:background="@drawable/pill_off"
                    android:text="Off"
                    android:textColor="@color/dust" />
            </LinearLayout>

            <TextView
                android:id="@+id/calendar_status"
                style="@style/BodyText" />
            <Button
                android:id="@+id/calendar_button"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Allow calendar" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/CardIcon"
                    android:src="@drawable/ic_buds" />

                <TextView
                    style="@style/CardTitle"
                    android:text="Galaxy Buds" />

                <TextView
                    android:id="@+id/buds_pill"
                    style="@style/Pill"
                    android:background="@drawable/pill_off"
                    android:text="Off"
                    android:textColor="@color/dust" />
            </LinearLayout>

            <TextView
                android:id="@+id/buds_status"
                style="@style/BodyText" />

            <Button
                android:id="@+id/buds_button"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Allow Bluetooth" />

            <Button
                android:id="@+id/buds_choose_button"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Earbuds: choose" />

            <TextView
                style="@style/NoteText"
                android:text="When your Buds connect, the widget shows each earbud's battery and an ANC / Ambient switch. If they won't connect, the Galaxy Wearable app may be holding the connection: close it and tap Connect now." />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/CardIcon"
                    android:src="@drawable/ic_music_note" />

                <TextView
                    style="@style/CardTitle"
                    android:text="Music" />

                <TextView
                    android:id="@+id/music_pill"
                    style="@style/Pill"
                    android:background="@drawable/pill_off"
                    android:text="Off"
                    android:textColor="@color/dust" />
            </LinearLayout>

            <TextView
                android:id="@+id/music_status"
                style="@style/BodyText" />

            <Button
                android:id="@+id/music_button"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Allow music access" />

            <Button
                android:id="@+id/music_unlock_button"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="Switch greyed out? Unlock it" />

            <TextView
                style="@style/NoteText"
                android:text="Android calls this notification access. The widget only uses it to see what's playing and control it, the same way the quick panel's media player does. If the switch is greyed out, tap Unlock it, then ⋮ (top right) → Allow restricted settings, and come back." />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/CardIcon"
                    android:src="@drawable/ic_opacity" />

                <TextView
                    style="@style/CardTitle"
                    android:text="Widget background" />

                <TextView
                    android:id="@+id/opacity_pill"
                    style="@style/Pill"
                    android:background="@drawable/pill_on"
                    android:text="90%"
                    android:textColor="@color/bone" />
            </LinearLayout>

            <TextView
                style="@style/BodyText"
                android:text="Slide left to see more of your wallpaper through the widget." />

            <SeekBar
                android:id="@+id/opacity_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="100"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:progressBackgroundTint="@color/dust"
                android:progressTint="@color/crimson"
                android:thumbTint="@color/crimson" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="See-through"
                    android:textColor="@color/dust"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solid"
                    android:textColor="@color/dust"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/add_widget_button"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.15"
            android:text="ADD WIDGET TO HOME SCREEN"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="On the widget, tap the clock for your alarms, the weather for the Weather app,\na day for your calendar, and ‹ › to change month."
            android:textColor="@color/dust"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
